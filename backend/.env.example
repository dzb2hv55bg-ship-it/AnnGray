# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://momento:momento_local_only@localhost:5432/momento
PORT=8080
# Optional legacy OIDC bridge only. The five dedicated MOMENTO channels do not use it.
JWT_ISSUER=https://identity.example.invalid/
JWT_AUDIENCE=momento-mobile-client
JWT_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json

# MOMENTO signs its own short-lived API access tokens. Use independent random secrets.
# Generate with: openssl rand -base64 48
MOMENTO_JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
MOMENTO_JWT_ISSUER=https://api.momento.example
MOMENTO_JWT_AUDIENCE=momento-api
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-byte-random-secret
PUBLIC_APP_URL=https://app.example.invalid


# Provider app credentials. Keep secrets on the backend only.
GOOGLE_SERVER_CLIENT_ID=
YANDEX_CLIENT_ID=
VK_CLIENT_ID=

# OTP security. Generate each secret independently; never reuse JWT/refresh secrets.
# openssl rand -base64 32
OTP_HMAC_SECRET=
CONTACT_HASH_SECRET=
CONTACT_ENCRYPTION_KEY=
# HTTPS JSON delivery adapters: MOMENTO sends {to, channel, template, code, expiresInMinutes}.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=
SMS_DELIVERY_URL=
SMS_DELIVERY_API_KEY=
